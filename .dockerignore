# Keep secrets, live runtime state, and local artifacts out of every image
# build context. The root .env carries real provider keys — it must never
# reach a build context or an image layer.
.git
.env
.env.*
!.env.example

# Dependency and build artifacts (recreated inside the images)
node_modules
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
**/*.tsbuildinfo

# Generated by TypeScript project references; a stale vite.config.js would
# shadow vite.config.ts inside the web build stage.
apps/web/vite.config.js
apps/web/vite.config.d.ts

# Live local data (runtime state JSON, vector sqlite, signing secret)
services/api/data

# Caches, test output, tooling
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
coverage
htmlcov
.playwright-cli
.claude
output
tmp
*.log

# Docs and assets not needed in any image
docs
Reference images
README.md
LICENSE.md
.DS_Store
**/.DS_Store
._*
**/._*
