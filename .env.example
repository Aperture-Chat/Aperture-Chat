# Set to the deployment environment. Anything other than local/dev/development/
# test/testing/ci is treated as DEPLOYED and fails closed on unsafe defaults
# (missing or public signing secret, plain user-id header auth).
APERTURE_ENV=local
# Signs session tokens, OIDC state, and derives the local secret vault key.
# In a deployed environment this MUST be a unique, high-entropy value of at
# least 32 characters; the API refuses to start on a missing or public default.
# Leaving it blank in local/dev auto-generates and persists a strong secret.
APERTURE_SECRET_KEY=
# Seed flags stay false for the release image so a fresh volume starts at the
# first-owner setup screen. Set them true only for deliberate demo/dev runs.
APERTURE_BOOTSTRAP_PLATFORM_OWNER_EMAIL=owner@aperture.local
APERTURE_BOOTSTRAP_TENANT_ADMIN_EMAIL=admin@example.local
APERTURE_LOCAL_AUTH_ENABLED=true
APERTURE_SEED_PLATFORM_OWNER_ENABLED=false
APERTURE_SEED_DEMO_DATA_ENABLED=false
# Relative paths apply to bare-metal runs from the repo root. docker-compose
# overrides both with absolute in-container paths on the api data volume.
APERTURE_RUNTIME_STATE_PATH=services/api/data/runtime_state.json
APERTURE_VECTOR_DB_PATH=services/api/data/knowledge_vectors.sqlite3
# Relational application state is introduced table-by-table. SQLite remains
# the default; leave APERTURE_DATABASE_URL blank unless deliberately selecting
# another installed SQLAlchemy dialect.
APERTURE_APPLICATION_DB_PATH=services/api/data/aperture.sqlite3
APERTURE_DATABASE_URL=
# Optional Docker Compose Postgres 16 profile. Set a unique password before
# starting `--profile postgres`; keep APERTURE_DATABASE_URL blank until the
# SQLite-to-Postgres dry-run and digest-bound import have succeeded.
APERTURE_POSTGRES_DB=aperture
APERTURE_POSTGRES_USER=aperture
APERTURE_POSTGRES_PASSWORD=
APERTURE_POSTGRES_BIND=127.0.0.1:5432
# After a successful import, use an explicitly percent-encoded password:
# APERTURE_DATABASE_URL=postgresql+psycopg://aperture:<password>@postgres:5432/aperture
# Review Grid matrices/cells stay in a dedicated WAL-mode SQLite database.
# Runs are bounded both by worker concurrency and by active/queued matrices.
APERTURE_REVIEW_DB_PATH=services/api/data/review.sqlite3
APERTURE_REVIEW_MAX_CONCURRENCY=3
APERTURE_REVIEW_MAX_QUEUED_RUNS=4
# Sessions & SSO: signed session tokens use APERTURE_SECRET_KEY. The legacy
# plain x-aperture-user header is honored ONLY in local/dev/test environments;
# deployed environments always require a signed session regardless of this flag.
APERTURE_DEV_HEADER_AUTH_ENABLED=false
# Sessions slide: the web app rotates its token on every load, so this TTL is
# the maximum idle gap between visits (default 7 days), not a cap on total
# signed-in time for an active user.
APERTURE_SESSION_TTL_SECONDS=604800
# Browser origins allowed by API CORS and used for auth/connector callback
# returns, comma-separated. Add every web origin that will call this API.
APERTURE_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176
# External base URL of the API; forms the OIDC redirect URI registered with IdPs.
APERTURE_API_BASE_URL=http://localhost:8000

# Bounded token-bucket request limits per API process. Auth/bootstrap/SCIM use
# the tighter auth limit; chat, OpenAI-compatible, transcription, image, and
# Review Grid endpoints use the model-work limit. Zero disables that class.
# Buckets start full (the configured value is also the immediate burst cap).
APERTURE_AUTH_RATE_LIMIT_PER_MINUTE=10
APERTURE_CHAT_RATE_LIMIT_PER_MINUTE=20
APERTURE_RATE_LIMIT_MAX_BUCKETS=10000
APERTURE_RATE_LIMIT_IDLE_TTL_SECONDS=300
# Trust X-Forwarded-For only from these comma-separated proxy IPs or CIDRs.
# Reverse-proxy deployments must configure the actual proxy address/subnet;
# leaving this empty safely ignores forwarded headers but gives every client
# behind that proxy one shared unauthenticated auth/SCIM bucket.
APERTURE_RATE_LIMIT_TRUSTED_PROXIES=

# SCIM provisioning (Entra/Okta directory sync). The /scim/v2 endpoints stay
# disabled (503) until a bearer token is set here.
APERTURE_SCIM_BEARER_TOKEN=

# Optional Elasticsearch export for audit analytics. When both are set, the
# in-process scheduler delivers buffered audit events to <url>/_bulk in the
# background; when unset, the platform console reports the export as not
# configured and events simply stay buffered.
APERTURE_ELASTIC_URL=
APERTURE_ELASTIC_API_KEY=

# In-process background scheduler (scheduled automations + Elastic delivery).
# Schedule times are interpreted in UTC.
APERTURE_SCHEDULER_ENABLED=true
APERTURE_SCHEDULER_INTERVAL_SECONDS=30

# Knowledge document ingestion. Uploads are validated on the request spool, so
# the per-file ceiling can be raised (up to 2048 MB; the web nginx proxy allows
# 2 GB bodies) without holding whole files in API memory. Scanned images and
# image-only PDF pages run through local Tesseract OCR inside the API
# container; audio and video are transcribed with a configured Gemini Flash
# model after ffmpeg extracts speech (and a few video stills). Videos without
# an audio track still yield visual notes from those stills. Dense retrieval
# embeds chunks with a local model baked into the image. OCR and embeddings
# stay on-box; transcription uses the same provider path as composer dictation.
APERTURE_KNOWLEDGE_UPLOAD_MAX_MB=250
APERTURE_KNOWLEDGE_OCR_ENABLED=true
APERTURE_KNOWLEDGE_DENSE_EMBEDDINGS_ENABLED=true

# MCP stdio runtime. Comma- or space-separated executable names/paths approved
# to run as local MCP servers. When set, only these commands may be spawned in
# any environment; when blank, stdio MCP stays available in local/dev but is
# refused in deployed environments, so remote (HTTP/SSE) MCP servers are the
# container default unless an operator approves specific executables here.
APERTURE_MCP_ALLOWED_COMMANDS=
# Comma-separated exact hostnames (no scheme/port) the outbound egress guard
# may reach even when they resolve to private/loopback addresses in a deployed
# environment — e.g. an internal SearXNG, on-prem connector, or internal
# remote MCP endpoint. Cloud-metadata and link-local ranges stay blocked
# unconditionally.
APERTURE_EGRESS_ALLOW_HOSTS=

BOX_BASE_URL=https://api.box.com/2.0

# OpenRouter (server-side only; never exposed to the browser or tenant admins)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_TITLE=Aperture Chat
OPENROUTER_APP_REFERER=http://localhost:5173

# Platform-hosted web search for non-OpenRouter providers (OpenRouter models
# use OpenRouter's native web plugin). "duckduckgo" needs no setup; switch to
# "searxng" and set the base URL once a SearXNG container is running, e.g.
#   docker run -d -p 8888:8080 searxng/searxng
# (the instance must allow JSON output: search.formats must include json).
APERTURE_WEB_SEARCH_ENGINE=duckduckgo
APERTURE_SEARXNG_BASE_URL=
APERTURE_WEB_SEARCH_MAX_RESULTS=5
APERTURE_WEB_SEARCH_TIMEOUT_SECONDS=12

# Per-call provider timeout for chat generation. Long-form requests may issue
# multiple provider calls (generation, continuation, quality revision); raise
# this for slow providers without rebuilding images.
APERTURE_MODEL_GATEWAY_TIMEOUT_SECONDS=300

# Caddy site address for the vps/prod profile. The safe default serves only the
# local hostname. Replace it with your DNS name to enable public automatic HTTPS.
APERTURE_CADDY_SITE_ADDRESS=localhost

# Host bindings used by docker-compose. Defaults bind internal services to
# localhost for testing instead of publishing them on every network interface.
APERTURE_WEB_BIND=127.0.0.1:5173
APERTURE_API_BIND=127.0.0.1:8000

# Used by docker-compose.release.yml when running prebuilt GitHub Container
# Registry images from a tagged release.
APERTURE_IMAGE_REGISTRY=ghcr.io/aperture-chat
APERTURE_IMAGE_TAG=v0.4.4

# Baked into the web bundle at BUILD time by Vite (docker-compose passes it as
# a build arg). Leave blank for portable same-origin API calls through nginx or
# Caddy. Set only when intentionally building a web image pinned to a different
# API origin.
VITE_API_BASE_URL=
